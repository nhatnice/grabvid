<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GrabVid</title>
    <link rel="stylesheet" href="./css/fonts.css"/>
    <link rel="stylesheet" href="./css/materialize.min.css"/>
    <link rel="stylesheet" href="./css/download.css"/>
    <script type="text/javascript" src="../js/materialize.min.js"></script>
    <script type="text/javascript" src="../js/jquery.js"></script>
    <script type="text/javascript" src="../js/scripts.js"></script>
    <link rel="icon" href="../favicon.png">
</head>
<body>
    <!--MENU BAR-->
    <div class="nav-bar" id="nav-bar">
        <!--MENU-->
        <div class="logo-contain" id = "logo-contain" >
            <a href="/"><img class="logo" id="logo" src="./resources/logo.svg"/></a>
            <a class="contacts" href="mailto:contact@nhattran.dev" target="_blank">Contact: contact@nhattran.dev</a>
        </div>
    </div>
    <!--DOWNLOAD CONTAIN-->
    <div class="container" id="container">
        <!--DOWNLOAD INPUT CONTAIN-->
        <div class="download-contain" id="info-contain">
            <form action="#" method="post" name="download-form" class="download-form" id="download-form">
                <!--URL ICON-->
                <div class="download-icon">
                    <img src="./resources/icons/url.svg"/>
                </div>
                <!--LINK INPUT-->
                <div class="link-input-contain">
                    <input placeholder="Put the link here..." name="link-input"  type="text" class="link-input" id="link-input"/>
                </div>
                <div class="submit-contain" id="submit-contain">
                  <button type="submit" class="waves-effect waves-light download-btn" id="download-btn"><a>DOWNLOAD</a>   
                      <div class="preloader-wrapper small active" id="loader-circle">
                          <div class="spinner-layer spinner-green-only">
                            <div class="circle-clipper left">
                              <div class="circle"></div>
                            </div><div class="gap-patch">
                              <div class="circle"></div>
                            </div><div class="circle-clipper right">
                              <div class="circle"></div>
                            </div>
                          </div>
                        </div></button>
              </div>
            </form>    
        </div>
        
        <div class="info-contain" id="info-contain">
            <h1 class="title-f" id="title-f">Online Video Downloader</h1>
            <h1 class="title-b" id="title-b">Download videos from Youtube, Facebook, Instagram, Reddit and many more.</h1>
            <div class="download-info">
                <div class="video-info">
                    <img class="video-thumb" src="<%=thumbnail%>"/>
                    </br></br>
                    <div class="video-title">
                        <span><%=title%></span>
                    </div>
                </div>
                <div class="format-list">
                    <table>
                        <thead>
                          <tr>
                              <th>Quality</th>
                              <th>Format</th>
                              <th>Type</th>
                              <th>Download</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% formats.forEach(function(f) { %>
                          <tr>
                            <td><%=f.quality%></td>
                            <td><%=f.ext%></td>
                            <td><%=f.type%></td>
                            <td><a href="<%=f.url%>" download>DOWNLOAD</a></td>
                          </tr>
                          <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
            <!--INFO-->
            <div class="info" id="info">
                <a class="copyright" style="font-weight:900" href="mailto:contact@nhattran.dev" target="_blank">Contact: contact@nhattran.dev</a>
                </br>
                <a class="copyright">Copyright © 2020 GrabVid. All rights reserved.</a>
            </div>
        </div>
    </div>
</body>
</html>